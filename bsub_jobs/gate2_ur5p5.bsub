#!/bin/bash
#BSUB -J "gate2_ur5p5[1-4]"
#BSUB -q BatchGPU
#BSUB -gpu "num=1:mode=shared"
#BSUB -R "rusage[mem=24000]"
#BSUB -W 2:00
#BSUB -o logs/gate2_ur5p5_%I.log

set -euo pipefail
shopt -s nullglob

mkdir -p logs
cd /scratch/jote9827/Github/Cylinder
source .venv/bin/activate

export VIV_NUM_WORKERS=0
export OMP_NUM_THREADS=4

: "${LSB_JOBINDEX:?LSB_JOBINDEX is not set}"

case "$LSB_JOBINDEX" in
  1) TAG="dim_nocontext" ;;
  2) TAG="dim_context" ;;
  3) TAG="nd_nocontext" ;;
  4) TAG="nd_context" ;;
  *)
    echo "Invalid LSB_JOBINDEX=$LSB_JOBINDEX" >&2
    exit 2
    ;;
esac

SUBDIR="generalization_Ur5.5_holdout_${TAG}"

# Prevent accidental overwriting of a previous Gate-2 receipt.
existing=(
  results/coupled_cylinder1000_Ur5.5_${SUBDIR}_\
forc-v1_additive_noise-none*handoff_2000_muNone.npz
)

if (( ${#existing[@]} > 0 )); then
  echo "Refusing to overwrite existing Gate-2 output:" >&2
  printf '  %s\n' "${existing[@]}" >&2
  exit 3
fi

echo "============================================================"
echo "Gate:        2 — held-out Ur test"
echo "Arm:         $TAG"
echo "Artifact:    results/$SUBDIR"
echo "Ur:          5.5"
echo "Handoff:     2000 steps"
echo "Total time:  700 s absolute simulation time"
echo "Forcing:     deterministic GRU only"
echo "Coordinates: resolved from artifact metadata"
if [[ "$TAG" == "dim_nocontext" ]]; then
  echo "Status:      diagnostic only — failed Gate 1"
else
  echo "Status:      eligible for Gate-2 assessment"
fi
echo "============================================================"

python -u -m src.viv_analysis.coupled_inference \
  --cfd_dataset cylinder1000 \
  --model_dataset cylinder1000 \
  --model_subdir "$SUBDIR" \
  --checkpoint gru_best.pt \
  --Ur 5.5 \
  --handoff_offset 2000 \
  --cfd_target_AD 0.351 \
  --forcing_mode v1_additive \
  --noise_mode none \
  --total_time 700