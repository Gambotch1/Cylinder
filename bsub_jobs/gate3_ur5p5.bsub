#!/bin/bash
#BSUB -J "gate3_ur5p5"
#BSUB -q BatchGPU
#BSUB -gpu "num=1:mode=shared"
#BSUB -R "rusage[mem=24000]"
#BSUB -W 4:00
#BSUB -o logs/gate3_ur5p5.log

set -euo pipefail
shopt -s nullglob

mkdir -p logs
cd /scratch/jote9827/Github/Cylinder
source .venv/bin/activate

export VIV_NUM_WORKERS=0
export OMP_NUM_THREADS=4

UR=5.5
CFD_AD=0.350372
CFD_F=0.216406
ANALYSIS_DT=0.005
TOTAL_TIME=700

# Three Gate-2 survivors.
ARMS=(
  "dim_context"
  "nd_nocontext"
  "nd_context"
)

# Initial amplitudes relative to the CFD A/D target:
#   below: 0.40, 0.55, 0.70
#   above: 1.30, 1.50
SEED_AD=(
  "0.1401488"
  "0.1927046"
  "0.2452604"
  "0.4554836"
  "0.5255580"
)

SEED_RATIO=(
  "0.40"
  "0.55"
  "0.70"
  "1.30"
  "1.50"
)

SEED_LABEL=(
  "below_040"
  "below_055"
  "below_070"
  "above_130"
  "above_150"
)

GIT_COMMIT="$(git rev-parse HEAD)"
GIT_DIRTY_COUNT="$(git status --porcelain | wc -l | tr -d ' ')"

echo "============================================================"
echo "Gate:             3 — two-sided held-out attractor test"
echo "Ur:               $UR"
echo "CFD target A/D:   $CFD_AD"
echo "CFD target f:     $CFD_F Hz"
echo "Analysis dt:      $ANALYSIS_DT s"
echo "Free-run time:    $TOTAL_TIME s"
echo "Git commit:       $GIT_COMMIT"
echo "Dirty file count: $GIT_DIRTY_COUNT"
echo "Arms:             ${ARMS[*]}"
echo "============================================================"

# The current coupled_inference.py uses a generic attractor filename.
# Refuse to begin if one is already present, because it could be stale.
stale_generic=(results/attractor_Ur${UR}_seed*.npz)

if (( ${#stale_generic[@]} > 0 )); then
  echo "BLOCKED: stale generic attractor outputs already exist:" >&2
  printf '  %s\n' "${stale_generic[@]}" >&2
  echo "Archive or remove them before running Gate 3." >&2
  exit 3
fi

for arm in "${ARMS[@]}"; do
  model_subdir="generalization_Ur5.5_holdout_${arm}"

  for j in "${!SEED_AD[@]}"; do
    ad_seed="${SEED_AD[$j]}"
    ratio="${SEED_RATIO[$j]}"
    seed_label="${SEED_LABEL[$j]}"

    output_npz="results/gate3_attractor_Ur${UR}_${arm}_${seed_label}.npz"
    run_log="logs/gate3_Ur${UR}_${arm}_${seed_label}.log"

    if [[ -e "$output_npz" ]]; then
      echo "BLOCKED: output already exists: $output_npz" >&2
      exit 4
    fi

    echo
    echo "============================================================"
    echo "Arm:          $arm"
    echo "Artifact:     $model_subdir"
    echo "Seed label:   $seed_label"
    echo "Seed ratio:   ${ratio} × CFD"
    echo "Seed A/D:     $ad_seed"
    echo "Target A/D:   $CFD_AD"
    echo "Target f:     $CFD_F Hz"
    echo "Forcing:      deterministic GRU only"
    echo "Coordinates:  resolved from artifact metadata"
    echo "Output:       $output_npz"
    echo "============================================================"

    python -u -m src.viv_analysis.coupled_inference \
      --cfd_dataset cylinder1000 \
      --model_dataset cylinder1000 \
      --model_subdir "$model_subdir" \
      --checkpoint gru_best.pt \
      --Ur "$UR" \
      --ad_seed "$ad_seed" \
      --cfd_target_AD "$CFD_AD" \
      --forcing_mode v1_additive \
      --noise_mode none \
      --total_time "$TOTAL_TIME" \
      2>&1 | tee "$run_log"

    # The current implementation writes exactly one generic attractor file.
    generated=(results/attractor_Ur${UR}_seed*.npz)

    if (( ${#generated[@]} != 1 )); then
      echo "ERROR: expected exactly one generic attractor NPZ after run." >&2
      echo "Found ${#generated[@]}:" >&2
      printf '  %s\n' "${generated[@]}" >&2
      exit 5
    fi

    mv -- "${generated[0]}" "$output_npz"

    # Add the missing experiment receipt metadata to the renamed NPZ.
    python - \
      "$output_npz" \
      "$arm" \
      "$model_subdir" \
      "$seed_label" \
      "$ratio" \
      "$CFD_F" \
      "$ANALYSIS_DT" \
      "$GIT_COMMIT" \
      "$GIT_DIRTY_COUNT" <<'PY'
from pathlib import Path
import sys

import numpy as np

(
    path_s,
    arm,
    model_subdir,
    seed_label,
    seed_ratio_s,
    cfd_f_s,
    analysis_dt_s,
    git_commit,
    git_dirty_count_s,
) = sys.argv[1:]

path = Path(path_s)

with np.load(path, allow_pickle=False) as data:
    payload = {key: data[key] for key in data.files}

payload.update(
    {
        "gate": np.asarray(3, dtype=np.int32),
        "gate3_arm": np.asarray(arm),
        "model_subdir": np.asarray(model_subdir),
        "checkpoint": np.asarray("gru_best.pt"),
        "seed_label": np.asarray(seed_label),
        "seed_ratio_to_cfd": np.asarray(float(seed_ratio_s)),
        "cfd_target_f": np.asarray(float(cfd_f_s)),
        "analysis_dt": np.asarray(float(analysis_dt_s)),
        "gate1_eligible": np.asarray(True),
        "git_commit": np.asarray(git_commit),
        "git_dirty_count": np.asarray(int(git_dirty_count_s)),
        "coordinate_mode": np.asarray(
            "nondimensional" if arm.startswith("nd_") else "dimensional"
        ),
        "use_ur_context": np.asarray(not arm.endswith("nocontext")),
    }
)

tmp = path.with_suffix(".tmp.npz")
np.savez(tmp, **payload)
tmp.replace(path)

print(f"Annotated receipt: {path}")
PY

    echo "Completed: $output_npz"
  done
done

echo
echo "============================================================"
echo "Gate 3 trajectory generation completed."
echo "Generated outputs:"
find results -maxdepth 1 \
  -name "gate3_attractor_Ur${UR}_*.npz" \
  -print | sort
echo "============================================================"