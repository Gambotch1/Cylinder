#!/bin/bash
#BSUB -J "gate4_ur5p5"
#BSUB -q BatchGPU
#BSUB -gpu "num=1:mode=shared"
#BSUB -R "rusage[mem=24000]"
#BSUB -W 3:00
#BSUB -o logs/gate4_%J_%I.log

set -euo pipefail
shopt -s nullglob

cd /scratch/jote9827/Github/Cylinder
source .venv/bin/activate

mkdir -p logs results

export VIV_NUM_WORKERS=0
export OMP_NUM_THREADS=4

STAGE="${STAGE:-coarse}"
JOB_INDEX="${LSB_JOBINDEX:-1}"

UR=5.5
CFD_AD=0.350372
CFD_F=0.216406
DT=0.005
D=0.4
FN=0.2
SEQ_LEN=1000
FREE_RUN=700.0

MODEL_SUBDIR="generalization_Ur5.5_holdout_nd_nocontext"
CHECKPOINT="gru_best.pt"

GIT_COMMIT="$(git rev-parse HEAD)"
GIT_DIRTY_COUNT="$(git status --porcelain | wc -l | tr -d ' ')"

ratio_tag () {
    python - "$1" <<'PY'
import sys
print(f"{float(sys.argv[1]):.4f}".replace(".", "p"))
PY
}

annotate_normal_run () {
    local src_npz="$1"
    local dst_npz="$2"
    local dst_json="$3"

    export G4_SRC_NPZ="$src_npz"
    export G4_DST_NPZ="$dst_npz"
    export G4_DST_JSON="$dst_json"

    python - <<'PY'
import json
import os
from pathlib import Path

import numpy as np


def env_float(name, default=None):
    value = os.environ.get(name, "")
    if value == "":
        return default
    return float(value)


src = Path(os.environ["G4_SRC_NPZ"])
dst = Path(os.environ["G4_DST_NPZ"])
json_path = Path(os.environ["G4_DST_JSON"])

if not src.exists():
    raise FileNotFoundError(src)

with np.load(src, allow_pickle=False) as data:
    payload = {key: data[key] for key in data.files}

required = ["h", "h_dot", "h_ddot", "cl", "t"]
missing = [key for key in required if key not in payload]
if missing:
    raise RuntimeError(
        f"{src} lacks exact state traces required for Gate 4: {missing}"
    )

receipt = {
    "gate": 4,
    "stage": os.environ["G4_STAGE"],
    "Ur": float(os.environ["G4_UR"]),
    "arm": "nd_nocontext",
    "model_subdir": os.environ["G4_MODEL_SUBDIR"],
    "checkpoint": os.environ["G4_CHECKPOINT"],
    "requested_seed_ratio": env_float("G4_RATIO"),
    "handoff_offset": int(os.environ["G4_OFFSET"]),
    "phase_label": os.environ["G4_PHASE_LABEL"],
    "measured_phase_rad": env_float("G4_PHASE_RAD"),
    "measured_phase_deg": env_float("G4_PHASE_DEG"),
    "unscaled_local_phase_AD": env_float("G4_LOCAL_AD"),
    "unscaled_window_rms_AD": env_float("G4_LOCAL_RMS_AD"),
    "scaled_window_rms_AD": env_float("G4_SCALED_RMS_AD"),
    "cfd_scale": env_float("G4_SCALE"),
    "initial_max_abs_z": env_float("G4_INITIAL_MAX_Z"),
    "handoff_time": env_float("G4_HANDOFF_TIME"),
    "free_run_duration": env_float("G4_FREE_RUN"),
    "absolute_total_time": env_float("G4_TOTAL_TIME"),
    "cfd_target_AD": env_float("G4_CFD_AD"),
    "cfd_target_f": env_float("G4_CFD_F"),
    "analysis_dt": env_float("G4_DT"),
    "noise_mode": "none",
    "forcing_mode": "v1_additive",
    "source_npz": str(src),
    "git_commit": os.environ["G4_GIT_COMMIT"],
    "git_dirty_count": int(os.environ["G4_GIT_DIRTY_COUNT"]),
}

payload.update(
    {
        "gate": np.asarray(4, dtype=np.int32),
        "gate4_stage": np.asarray(receipt["stage"]),
        "gate4_arm": np.asarray(receipt["arm"]),
        "requested_seed_ratio": np.asarray(
            receipt["requested_seed_ratio"], dtype=np.float64
        ),
        "handoff_offset": np.asarray(
            receipt["handoff_offset"], dtype=np.int32
        ),
        "measured_phase_rad": np.asarray(
            receipt["measured_phase_rad"], dtype=np.float64
        ),
        "measured_phase_deg": np.asarray(
            receipt["measured_phase_deg"], dtype=np.float64
        ),
        "unscaled_local_phase_AD": np.asarray(
            receipt["unscaled_local_phase_AD"], dtype=np.float64
        ),
        "unscaled_window_rms_AD": np.asarray(
            receipt["unscaled_window_rms_AD"], dtype=np.float64
        ),
        "scaled_window_rms_AD": np.asarray(
            receipt["scaled_window_rms_AD"], dtype=np.float64
        ),
        "cfd_scale": np.asarray(
            receipt["cfd_scale"], dtype=np.float64
        ),
        "initial_max_abs_z": np.asarray(
            receipt["initial_max_abs_z"], dtype=np.float64
        ),
        "handoff_time": np.asarray(
            receipt["handoff_time"], dtype=np.float64
        ),
        "free_run_duration": np.asarray(
            receipt["free_run_duration"], dtype=np.float64
        ),
        "cfd_target_AD": np.asarray(
            receipt["cfd_target_AD"], dtype=np.float64
        ),
        "cfd_target_f": np.asarray(
            receipt["cfd_target_f"], dtype=np.float64
        ),
        "analysis_dt": np.asarray(
            receipt["analysis_dt"], dtype=np.float64
        ),
        "source_npz": np.asarray(str(src)),
        "git_commit": np.asarray(receipt["git_commit"]),
        "git_dirty_count": np.asarray(
            receipt["git_dirty_count"], dtype=np.int32
        ),
    }
)

tmp = dst.with_suffix(".tmp.npz")
np.savez(tmp, **payload)
tmp.replace(dst)

json_path.write_text(json.dumps(receipt, indent=2))

print(f"Gate-4 NPZ receipt:  {dst}")
print(f"Gate-4 JSON receipt: {json_path}")
PY
}


# =====================================================================
# Known-positive NN calibration control
# =====================================================================
if [[ "$STAGE" == "control" ]]; then
    if [[ "$JOB_INDEX" != "1" ]]; then
        echo "control stage requires one job only" >&2
        exit 2
    fi

    CONTROL_AD=0.4554836
    GENERIC="results/attractor_Ur${UR}_seed${CONTROL_AD}.npz"
    OUTPUT="results/gate4_control_Ur${UR}_nd_nocontext_analytic_r130.npz"
    RECEIPT="results/gate4_control_Ur${UR}_nd_nocontext_analytic_r130.json"
    RUN_LOG="logs/gate4_control_Ur${UR}_nd_nocontext_analytic_r130.log"

    if [[ -e "$GENERIC" ]]; then
        echo "BLOCKED: stale generic attractor file exists: $GENERIC" >&2
        exit 3
    fi

    if [[ -e "$OUTPUT" || -e "$RECEIPT" ]]; then
        echo "BLOCKED: Gate-4 control output already exists" >&2
        exit 4
    fi

    echo "============================================================"
    echo "Gate 4 positive control"
    echo "Known runaway: analytic A/D=$CONTROL_AD"
    echo "Arm:           nd_nocontext"
    echo "Free run:      $FREE_RUN s"
    echo "============================================================"

    python -u -m src.viv_analysis.coupled_inference \
        --cfd_dataset cylinder1000 \
        --model_dataset cylinder1000 \
        --model_subdir "$MODEL_SUBDIR" \
        --checkpoint "$CHECKPOINT" \
        --Ur "$UR" \
        --ad_seed "$CONTROL_AD" \
        --cfd_target_AD "$CFD_AD" \
        --forcing_mode v1_additive \
        --noise_mode none \
        --total_time "$FREE_RUN" \
        2>&1 | tee "$RUN_LOG"

    if [[ ! -e "$GENERIC" ]]; then
        echo "ERROR: expected control output not found: $GENERIC" >&2
        exit 5
    fi

    export G4_STAGE="control"
    export G4_UR="$UR"
    export G4_MODEL_SUBDIR="$MODEL_SUBDIR"
    export G4_CHECKPOINT="$CHECKPOINT"
    export G4_RATIO="1.30"
    export G4_OFFSET="0"
    export G4_PHASE_LABEL="analytic_phase0"
    export G4_PHASE_RAD="0.0"
    export G4_PHASE_DEG="0.0"
    export G4_LOCAL_AD="$CONTROL_AD"
    export G4_LOCAL_RMS_AD="$CONTROL_AD"
    export G4_SCALED_RMS_AD="$CONTROL_AD"
    export G4_SCALE="1.0"
    export G4_INITIAL_MAX_Z=""
    export G4_HANDOFF_TIME="0.0"
    export G4_FREE_RUN="$FREE_RUN"
    export G4_TOTAL_TIME="$FREE_RUN"
    export G4_CFD_AD="$CFD_AD"
    export G4_CFD_F="$CFD_F"
    export G4_DT="$DT"
    export G4_GIT_COMMIT="$GIT_COMMIT"
    export G4_GIT_DIRTY_COUNT="$GIT_DIRTY_COUNT"

    annotate_normal_run "$GENERIC" "$OUTPUT" "$RECEIPT"
    rm -f "$GENERIC"

    echo "Gate-4 positive control complete."
    exit 0
fi


# =====================================================================
# Boundary sweep and phase-resolved sweep
# =====================================================================
COARSE_RATIOS=(
    "0.80"
    "0.90"
    "1.00"
    "1.10"
    "1.15"
    "1.20"
    "1.25"
    "1.30"
)

PHASE_OFFSETS=(
    "2000"
    "2231"
    "2462"
    "2693"
)

case "$STAGE" in
    coarse)
        idx=$((JOB_INDEX - 1))

        if (( idx < 0 || idx >= ${#COARSE_RATIOS[@]} )); then
            echo "Invalid coarse array index: $JOB_INDEX" >&2
            exit 10
        fi

        RATIO="${COARSE_RATIOS[$idx]}"
        OFFSET=2000
        PHASE_LABEL="reference"
        NOISE_SEED=$((4100 + JOB_INDEX))
        ;;

    phase)
        : "${GATE4_PHASE_RATIO_1:?Missing GATE4_PHASE_RATIO_1}"
        : "${GATE4_PHASE_RATIO_2:?Missing GATE4_PHASE_RATIO_2}"
        : "${GATE4_PHASE_RATIO_3:?Missing GATE4_PHASE_RATIO_3}"

        PHASE_RATIOS=(
            "$GATE4_PHASE_RATIO_1"
            "$GATE4_PHASE_RATIO_2"
            "$GATE4_PHASE_RATIO_3"
        )

        nphase="${#PHASE_OFFSETS[@]}"
        total_jobs=$(( ${#PHASE_RATIOS[@]} * nphase ))
        idx=$((JOB_INDEX - 1))

        if (( idx < 0 || idx >= total_jobs )); then
            echo "Invalid phase array index: $JOB_INDEX" >&2
            echo "Expected 1-${total_jobs}" >&2
            exit 11
        fi

        ratio_idx=$((idx / nphase))
        phase_idx=$((idx % nphase))

        RATIO="${PHASE_RATIOS[$ratio_idx]}"
        OFFSET="${PHASE_OFFSETS[$phase_idx]}"
        PHASE_LABEL="quarter_${phase_idx}"
        NOISE_SEED=$((4200 + JOB_INDEX))
        ;;

    *)
        echo "Invalid STAGE='$STAGE'; use control, coarse, or phase" >&2
        exit 12
        ;;
esac


# ---------------------------------------------------------------------
# Calibrate cfd_scale for equal local phase-space amplitude.
#
# A_local/D = sqrt(h^2 + (v/omega_CFD)^2) / D
#
# The entire CFD warm-start history and initial structural state are then
# scaled by the same factor, preserving CFD waveform and phase.
# ---------------------------------------------------------------------
CALIBRATION_LINE="$(
    python - \
        "$UR" \
        "$RATIO" \
        "$OFFSET" \
        "$CFD_AD" \
        "$CFD_F" \
        "$FREE_RUN" \
        "$SEQ_LEN" \
        "$MODEL_SUBDIR" <<'PY'
import contextlib
import pickle
import sys
from pathlib import Path

import numpy as np

from viv_analysis.config import config, structural_params
from viv_analysis.preprocess import merge_dataframes, compute_kinematics
from viv_analysis.utils import format_ur_label


(
    ur_s,
    ratio_s,
    offset_s,
    cfd_ad_s,
    cfd_f_s,
    free_run_s,
    seq_len_s,
    model_subdir,
) = sys.argv[1:]

Ur = float(ur_s)
ratio = float(ratio_s)
offset = int(offset_s)
cfd_ad = float(cfd_ad_s)
cfd_f = float(cfd_f_s)
free_run = float(free_run_s)
seq_len = int(seq_len_s)

D = float(config["cylinder1000_D_ref"])
fn = float(config["cylinder1000_fn"])
U = Ur * fn * D
release_time = 400.0 / Ur
omega = 2.0 * np.pi * cfd_f

# Redirect noisy preprocessing receipts to stderr. Bash command substitution
# captures stdout only, so stdout remains one machine-readable numeric line.
with contextlib.redirect_stdout(sys.stderr):
    df = merge_dataframes(dataset="cylinder1000")
    df = compute_kinematics(
        df,
        dataset="cylinder1000",
        structural_params=structural_params(),
    )

case = (
    df[df["case"].astype(str) == format_ur_label(Ur)]
    .sort_values(["time", "step"])
    .reset_index(drop=True)
)

if case.empty:
    raise RuntimeError(f"Missing CFD case Ur={Ur}")

t = case["time"].to_numpy(dtype=np.float64)
release_idx = int(np.searchsorted(t, release_time, side="left"))
handoff_idx = release_idx + seq_len + offset

if handoff_idx >= len(case):
    raise RuntimeError(
        f"handoff_idx={handoff_idx} exceeds case length={len(case)}"
    )

win_start = handoff_idx - seq_len
win = case.iloc[win_start:handoff_idx]

h0 = float(case["disp"].iloc[handoff_idx])
v0 = float(case["vel"].iloc[handoff_idx])

local_ad = np.sqrt(h0**2 + (v0 / omega)**2) / D
if not np.isfinite(local_ad) or local_ad <= 0:
    raise RuntimeError(f"Invalid local phase-space A/D: {local_ad}")

target_ad = ratio * cfd_ad
scale = target_ad / local_ad

local_rms_ad = np.sqrt(2.0) * float(np.std(win["disp"])) / D
scaled_rms_ad = scale * local_rms_ad

phase_rad = float(
    np.mod(np.arctan2(h0, v0 / omega), 2.0 * np.pi)
)
phase_deg = float(np.degrees(phase_rad))

handoff_time = float(t[handoff_idx])
total_time_abs = handoff_time + free_run

artifact_dir = Path("results") / model_subdir
with open(artifact_dir / "x_scaler.pkl", "rb") as file:
    x_scaler = pickle.load(file)

kin = (
    win[["disp", "vel", "acc"]]
    .to_numpy(dtype=np.float64)
    * scale
)

kin_nd = kin / np.asarray(
    [D, U, U * U / D],
    dtype=np.float64,
)

z = x_scaler.transform(kin_nd)
initial_max_z = float(np.max(np.abs(z)))

values = [
    scale,
    handoff_time,
    total_time_abs,
    local_ad,
    local_rms_ad,
    scaled_rms_ad,
    phase_rad,
    phase_deg,
    initial_max_z,
]

# This must be the only stdout emitted by this helper.
print(" ".join(f"{value:.12g}" for value in values))
PY
)"

echo "Calibration receipt: $CALIBRATION_LINE"

read -r \
    SCALE \
    HANDOFF_TIME \
    TOTAL_TIME_ABS \
    LOCAL_AD \
    LOCAL_RMS_AD \
    SCALED_RMS_AD \
    PHASE_RAD \
    PHASE_DEG \
    INITIAL_MAX_Z \
    EXTRA_FIELD \
    <<< "$CALIBRATION_LINE"

if [[ -n "${EXTRA_FIELD:-}" ]]; then
    echo "ERROR: calibration helper returned too many fields:" >&2
    echo "  $CALIBRATION_LINE" >&2
    exit 13
fi

for name in \
    SCALE \
    HANDOFF_TIME \
    TOTAL_TIME_ABS \
    LOCAL_AD \
    LOCAL_RMS_AD \
    SCALED_RMS_AD \
    PHASE_RAD \
    PHASE_DEG \
    INITIAL_MAX_Z
do
    value="${!name:-}"

    if [[ -z "$value" ]]; then
        echo "ERROR: missing calibration field $name" >&2
        echo "Raw line: $CALIBRATION_LINE" >&2
        exit 14
    fi

    python - "$name" "$value" <<'PY'
import math
import sys

name, value_s = sys.argv[1:]
try:
    value = float(value_s)
except ValueError as exc:
    raise SystemExit(
        f"ERROR: {name} is not numeric: {value_s!r}"
    ) from exc

if not math.isfinite(value):
    raise SystemExit(
        f"ERROR: {name} is not finite: {value_s!r}"
    )
PY
done



RATIO_TAG="$(ratio_tag "$RATIO")"

OUTPUT_NPZ="results/gate4_${STAGE}_Ur${UR}_nd_nocontext_r${RATIO_TAG}_off${OFFSET}.npz"
OUTPUT_JSON="results/gate4_${STAGE}_Ur${UR}_nd_nocontext_r${RATIO_TAG}_off${OFFSET}.json"
OUTPUT_PNG="results/gate4_${STAGE}_Ur${UR}_nd_nocontext_r${RATIO_TAG}_off${OFFSET}.png"
RUN_LOG="logs/gate4_${STAGE}_Ur${UR}_nd_nocontext_r${RATIO_TAG}_off${OFFSET}.log"

if [[ -e "$OUTPUT_NPZ" || -e "$OUTPUT_JSON" ]]; then
    echo "BLOCKED: normalized Gate-4 output already exists" >&2
    echo "  $OUTPUT_NPZ" >&2
    echo "  $OUTPUT_JSON" >&2
    exit 20
fi

echo "============================================================"
echo "Gate:                    4"
echo "Stage:                   $STAGE"
echo "Arm:                     nd_nocontext"
echo "Array index:             $JOB_INDEX"
echo "Requested ratio:         $RATIO × CFD"
echo "Handoff offset:          $OFFSET steps"
echo "Phase label:             $PHASE_LABEL"
echo "Measured phase:          $PHASE_DEG degrees"
echo "Unscaled local A/D:      $LOCAL_AD"
echo "Unscaled window RMS A/D: $LOCAL_RMS_AD"
echo "Applied cfd_scale:       $SCALE"
echo "Scaled window RMS A/D:   $SCALED_RMS_AD"
echo "Initial max |z|:         $INITIAL_MAX_Z"
echo "Handoff time:            $HANDOFF_TIME s"
echo "Absolute total time:     $TOTAL_TIME_ABS s"
echo "Free-run duration:       $FREE_RUN s"
echo "Noise-seed filename tag: $NOISE_SEED"
echo "Git commit:              $GIT_COMMIT"
echo "Dirty file count:        $GIT_DIRTY_COUNT"
echo "============================================================"

python -u -m src.viv_analysis.coupled_inference \
    --cfd_dataset cylinder1000 \
    --model_dataset cylinder1000 \
    --model_subdir "$MODEL_SUBDIR" \
    --checkpoint "$CHECKPOINT" \
    --Ur "$UR" \
    --handoff_offset "$OFFSET" \
    --cfd_scale "$SCALE" \
    --cfd_target_AD "$CFD_AD" \
    --forcing_mode v1_additive \
    --noise_mode none \
    --noise_seed "$NOISE_SEED" \
    --total_time "$TOTAL_TIME_ABS" \
    2>&1 | tee "$RUN_LOG"

SOURCE_NPZ="$(
    sed -n 's/^Saved coupled trajectory -> //p' "$RUN_LOG" | tail -n 1
)"

SOURCE_PNG="$(
    sed -n 's/^Saved coupled VIV plot to //p' "$RUN_LOG" | tail -n 1
)"

if [[ -z "$SOURCE_NPZ" || ! -f "$SOURCE_NPZ" ]]; then
    echo "ERROR: could not resolve generated NPZ from log" >&2
    exit 21
fi

export G4_STAGE="$STAGE"
export G4_UR="$UR"
export G4_MODEL_SUBDIR="$MODEL_SUBDIR"
export G4_CHECKPOINT="$CHECKPOINT"
export G4_RATIO="$RATIO"
export G4_OFFSET="$OFFSET"
export G4_PHASE_LABEL="$PHASE_LABEL"
export G4_PHASE_RAD="$PHASE_RAD"
export G4_PHASE_DEG="$PHASE_DEG"
export G4_LOCAL_AD="$LOCAL_AD"
export G4_LOCAL_RMS_AD="$LOCAL_RMS_AD"
export G4_SCALED_RMS_AD="$SCALED_RMS_AD"
export G4_SCALE="$SCALE"
export G4_INITIAL_MAX_Z="$INITIAL_MAX_Z"
export G4_HANDOFF_TIME="$HANDOFF_TIME"
export G4_FREE_RUN="$FREE_RUN"
export G4_TOTAL_TIME="$TOTAL_TIME_ABS"
export G4_CFD_AD="$CFD_AD"
export G4_CFD_F="$CFD_F"
export G4_DT="$DT"
export G4_GIT_COMMIT="$GIT_COMMIT"
export G4_GIT_DIRTY_COUNT="$GIT_DIRTY_COUNT"

annotate_normal_run "$SOURCE_NPZ" "$OUTPUT_NPZ" "$OUTPUT_JSON"

if [[ -n "$SOURCE_PNG" && -f "$SOURCE_PNG" ]]; then
    cp -p -- "$SOURCE_PNG" "$OUTPUT_PNG"
    echo "Gate-4 plot receipt: $OUTPUT_PNG"
fi

echo
echo "Gate-4 run complete:"
echo "  $OUTPUT_NPZ"
echo "  $OUTPUT_JSON"