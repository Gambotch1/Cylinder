#!/bin/bash
#BSUB -J "gen_train[1-4]"
#BSUB -q BatchGPU
#BSUB -gpu "num=1:mode=shared"
#BSUB -R "rusage[mem=32000]"
#BSUB -W 48:00
#BSUB -o logs/gen_train_%I.log

set -euo pipefail

mkdir -p logs
cd /scratch/jote9827/Github/Cylinder
source .venv/bin/activate

export VIV_NUM_WORKERS=0
export OMP_NUM_THREADS=4

: "${LSB_JOBINDEX:?LSB_JOBINDEX is not set}"

MODE="${MODE:-production}"
SEED=123
NOISE=0.05
BATCH_SIZE=512
SEQ_LEN=1000

case "$MODE" in
  smoke)
    EPOCHS=1
    PREFIX="smoke_generalization_Ur5.5_holdout"
    ;;
  production)
    EPOCHS=100
    PREFIX="generalization_Ur5.5_holdout"
    ;;
  *)
    echo "Invalid MODE='$MODE'; expected smoke or production" >&2
    exit 2
    ;;
esac

ARGS=(
  --cfd_dataset cylinder1000
  --holdout_ur 5.5
  --epochs "$EPOCHS"
  --batch_size "$BATCH_SIZE"
  --seq_len "$SEQ_LEN"
  --noise_std "$NOISE"
  --seed "$SEED"
  --num_workers 0
)

case "$LSB_JOBINDEX" in
  1)
    TAG="dim_nocontext"
    ARGS+=(--no_ur_context)
    ;;
  2)
    TAG="dim_context"
    ARGS+=(--use_ur_context)
    ;;
  3)
    TAG="nd_nocontext"
    ARGS+=(--nd_inputs --no_ur_context)
    ;;
  4)
    TAG="nd_context"
    ARGS+=(--nd_inputs --use_ur_context)
    ;;
  *)
    echo "Invalid LSB_JOBINDEX='$LSB_JOBINDEX'" >&2
    exit 2
    ;;
esac

EXP_SUBDIR="${PREFIX}_${TAG}"
ARGS+=(--exp_subdir "$EXP_SUBDIR")

echo "============================================================"
echo "Mode:        $MODE"
echo "Array index: $LSB_JOBINDEX"
echo "Arm:         $TAG"
echo "Epochs:      $EPOCHS"
echo "Output:      results/$EXP_SUBDIR"
echo "Command:"
printf ' %q' python -u -m src.viv_analysis.train_gru "${ARGS[@]}"
echo
echo "============================================================"

python -u -m src.viv_analysis.train_gru "${ARGS[@]}"