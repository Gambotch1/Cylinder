+    echo "No manifest entry for array index ${JOB_INDEX}" >&2
+    exit 2
+fi
+
+read -r INDEX U UR CASE N_SAMPLES <<< "$line"
+
+if [[ "$INDEX" != "$JOB_INDEX" ]]; then
